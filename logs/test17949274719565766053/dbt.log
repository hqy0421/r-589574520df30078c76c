  from __src
  where __doc_key is null
  having count(*) > 0
  union all
  select 'unknown node kind', __doc_key::varchar, node_id, 'kind=' || coalesce(kind, 'NULL')
  from __src
  where kind not in ('object', 'array', 'string', 'number', 'boolean', 'null') or kind is null
  union all
