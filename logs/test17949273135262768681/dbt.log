    when json_type(n.__j) = 'ARRAY' then 'array'
    when json_type(n.__j) = 'VARCHAR' then 'string'
    when json_type(n.__j) = 'BOOLEAN' then 'boolean'
    when json_type(n.__j) = 'NULL' then 'null'
